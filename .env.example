# ── Mahoraga .env.example ─────────────────────────────────────────────────────
# Copy to .env and edit before running.

# ── CORS (PATCH: never use * in production) ────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# ── WebSocket auth (PATCH: set a secret to require token on WS connect) ────────
# Leave blank for open access (local dev only).
# When set, clients must pass { auth: { token: "your-secret" } } on socket.connect()
WS_TOKEN=

# ── Risk & RL ──────────────────────────────────────────────────────────────────
RISK_THRESHOLD=70
RED_TRAINING_STEPS=50000
BLUE_RETRAIN_INTERVAL=100

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=data/threat_memory.db
BASELINE_CSV=data/baseline_traffic.csv

# ── LLM (Ollama) ───────────────────────────────────────────────────────────────
USE_LLM_REPORTS=true
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ── Simulation node auth (PATCH: shared secret between backend and sim nodes) ──
# Set the same value in docker-compose.yml env for each node.
NODE_API_SECRET=change-me-in-production
